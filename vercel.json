{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/data/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=600, stale-while-revalidate=86400"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/data/(.*)", "status": 404 },
    { "src": "/assets/(.*)", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
