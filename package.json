{
  "name": "vsinger-singer-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:web": "vite",
    "build": "npm run prepare:public && npm run api:build && vite build",
    "start": "node server.ts",
    "clean": "rm -rf dist",
    "lint": "vue-tsc --noEmit",
    "prepare:public": "tsx scripts/prepare-public.ts",
    "api:build": "tsx scripts/build-api.ts",
    "data:sync": "tsx scripts/sync.ts",
    "data:index": "tsx scripts/build-index.ts",
    "data:reclassify": "tsx scripts/reclassify.ts",
    "data:volumes": "tsx scripts/split-volumes.ts",
    "data:import-playlist": "tsx scripts/import-playlist.ts",
    "data:details": "tsx scripts/fill-details.ts",
    "data:links": "tsx scripts/resolve-links.ts",
    "data:discover": "tsx scripts/discover.ts",
    "data:vtubie-groups": "tsx scripts/harvest-vtubie-groups.ts",
    "data:vtubie-import": "tsx scripts/import-vtubie-groups.ts",
    "data:bacharu": "tsx scripts/harvest-bacharu.ts",
    "data:bacharu-import": "tsx scripts/import-bacharu.ts",
    "data:hololist": "tsx scripts/harvest-hololist.ts",
    "data:hololist-import": "tsx scripts/import-hololist.ts",
    "data:singing-events": "tsx scripts/harvest-singing-events.ts",
    "data:singing-events-youtube": "tsx scripts/harvest-youtube-singing-tags.ts",
    "data:singing-events-virtuallivecalendar": "tsx scripts/harvest-virtuallivecalendar.ts",
    "data:singing-events-twipla": "tsx scripts/harvest-twipla.ts",
    "data:import-suggestions": "tsx scripts/import-suggestions.ts",
    "data:analytics:append": "tsx scripts/append-analytics.ts",
    "data:ids": "tsx scripts/fill-details.ts --normalize-ids",
    "data:avatars": "tsx scripts/fill-details.ts",
    "data:validate": "tsx scripts/validate.ts",
    "repo:size": "tsx scripts/repo-size.ts",
    "data:all": "npm run data:sync && npm run data:index && npm run data:validate",
    "sync": "npm run data:sync",
    "build:index": "npm run data:index",
    "validate": "npm run data:validate",
    "data:verify": "tsx scripts/verify.ts",
    "data:vtuberhk": "tsx scripts/harvest-vtuberhk.ts",
    "data:vtuberhk-import": "tsx scripts/import-vtuberhk.ts",
    "data:fandom": "tsx scripts/harvest-fandom.ts",
    "data:fandom-import": "tsx scripts/import-fandom.ts",
    "data:vtuber-db": "tsx scripts/harvest-vtuber-db.ts",
    "data:vtuber-db-import": "tsx scripts/import-vtuber-db.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "cime-sdk": "^1.2.0",
    "consola": "^3.4.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "vite": "^8.3.5",
    "vue": "^3.6.0-rc.13",
    "youtubei.js": "^18.3.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@vitejs/plugin-vue": {
      "vue": "$vue"
    }
  }
