{
  "name": "vsinger-singer-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "oxnode server.ts",
    "dev:web": "vite",
    "build": "npm run prepare:public && npm run api:build && vite build",
    "start": "node server.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --runExternalCode",
    "prepare:public": "oxnode scripts/prepare-public.ts",
    "api:build": "oxnode scripts/build-api.ts",
    "data:sync": "oxnode scripts/sync.ts",
    "data:live": "oxnode scripts/sync.ts --live-only",
    "data:index": "oxnode scripts/build-index.ts",
    "data:reclassify": "oxnode scripts/reclassify.ts",
    "data:volumes": "oxnode scripts/split-volumes.ts",
    "data:import-playlist": "oxnode scripts/import-playlist.ts",
    "data:details": "oxnode scripts/fill-details.ts",
    "data:links": "oxnode scripts/resolve-links.ts",
    "data:discover": "oxnode scripts/discover.ts",
    "data:vtubie-groups": "oxnode scripts/harvest-vtubie-groups.ts",
    "data:vtubie-import": "oxnode scripts/import-vtubie-groups.ts",
    "data:bacharu": "oxnode scripts/harvest-bacharu.ts",
    "data:bacharu-import": "oxnode scripts/import-bacharu.ts",
    "data:hololist": "oxnode scripts/harvest-hololist.ts",
    "data:hololist-import": "oxnode scripts/import-hololist.ts",
    "data:singing-events": "oxnode scripts/harvest-singing-events.ts",
    "data:singing-events-youtube": "oxnode scripts/harvest-youtube-singing-tags.ts",
    "data:singing-events-virtuallivecalendar": "oxnode scripts/harvest-virtuallivecalendar.ts",
    "data:singing-events-twipla": "oxnode scripts/harvest-twipla.ts",
    "data:import-suggestions": "oxnode scripts/import-suggestions.ts",
    "data:analytics:append": "oxnode scripts/append-analytics.ts",
    "data:ids": "oxnode scripts/fill-details.ts --normalize-ids",
    "data:avatars": "oxnode scripts/fill-details.ts",
    "data:validate": "oxnode scripts/validate.ts",
    "repo:size": "oxnode scripts/repo-size.ts",
    "data:all": "npm run data:sync && npm run data:index && npm run data:validate",
    "sync": "npm run data:sync",
    "build:index": "npm run data:index",
    "validate": "npm run data:validate",
    "data:verify": "oxnode scripts/verify.ts",
    "data:vtuberhk": "oxnode scripts/harvest-vtuberhk.ts",
    "data:vtuberhk-import": "oxnode scripts/import-vtuberhk.ts",
    "data:fandom": "oxnode scripts/harvest-fandom.ts",
    "data:fandom-import": "oxnode scripts/import-fandom.ts",
    "data:vtuber-db": "oxnode scripts/harvest-vtuber-db.ts",
    "data:vtuber-db-import": "oxnode scripts/import-vtuber-db.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "cime-sdk": "^1.2.0",
    "consola": "^3.4.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "vite": "^8.3.5",
    "vue": "^3.6.0-rc.13",
    "youtubei.js": "^18.3.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@oxc-node/cli": "^1.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vue/content-mapper": "^4.0.0-alpha.2",
    "typescript": "^7.1.0-beta",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@vitejs/plugin-vue": {
      "vue": "$vue"
    }
  }
}
