# ─────────────────────────────────────────────────────────────────────────────
#  Line endings
# ─────────────────────────────────────────────────────────────────────────────
# Normalise every text file to LF in the repository, and check it out with LF
# on every platform. Without this, a Windows checkout converts LF to CRLF and
# every diff shows the whole file as changed.
* text=auto eol=lf

# Explicit overrides for files that must stay LF even when a tool wants to
# rewrite them.
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Windows scripts must keep CRLF so they run from cmd.exe.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ─────────────────────────────────────────────────────────────────────────────
#  Git LFS
# ─────────────────────────────────────────────────────────────────────────────
# GitHub Free allows ~1 GB of repository content (hard limit 2 GB) and a 2 GB
# maximum for a single LFS file. The JSON dataset in `data/` is deliberately
# kept as plain text so it can be diffed, reviewed and served directly from
# GitHub Pages — it is small enough (a few MB) that LFS would only make it
# harder to work with.
#
# LFS is used for the *binary* artefacts instead, which are opaque to git and
# would otherwise bloat every clone.
#
# Before committing LFS files for the first time, install the LFS client and
# make sure `git lfs install` has been run. GitHub Actions installs it
# automatically via `git lfs install --skip-repo` in the sync workflow.
*.db     filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
*.sqlite3 filter=lfs diff=lfs merge=lfs -text
*.zip    filter=lfs diff=lfs merge=lfs -text

# Large media that may be added later.
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.webm   filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text

# The dataset itself stays as plain text so diffs and Pages serving work.
# It is already covered by the `*.json text eol=lf` rule above, and no LFS
# filter applies to it.
