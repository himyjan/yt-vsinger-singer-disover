# ─────────────────────────────────────────────────────────────
#  Supported platforms and their credentials
# ─────────────────────────────────────────────────────────────
#
#  Platform           | Credentials needed? | Notes
#  -------------------|---------------------|--------------------------------------------------
#  YouTube            | OPTIONAL            | Data API v3 key; InnerTube (youtubei.js) is quota-free
#  Twitch             | OPTIONAL            | Helix API needs Client ID + Secret
#  Bilibili           | NO                  | Public API; no credentials needed
#  Niconico           | NO                  | Content Search API v2; no credentials needed
#  VK                 | OPTIONAL            | Service token for profile refresh
#  CHZZK              | NO                  | Public API; no credentials needed
#  KICK               | NO                  | Public API; no credentials needed
#  SOOP               | NO                  | Public API; no credentials needed
#  CI.ME              | OPTIONAL            | Open API needs Client ID + Secret for profiles
#
# ─────────────────────────────────────────────────────────────
#  Data pipeline secrets (used by scripts/sync.ts in CI and locally)
# ─────────────────────────────────────────────────────────────

# YouTube Data API v3 key. OPTIONAL.
# Create one at https://console.cloud.google.com/apis/credentials
# and enable the "YouTube Data API v3" API for the project.
# Free tier: 10,000 quota units per day.
# InnerTube (youtubei.js) is the primary source and costs no quota;
# the API key is only a fallback for failed InnerTube lookups and
# richer video statistics. Leave blank to run quota-free.
YOUTUBE_API_KEY="AIzaSyExample1234567890abcdefghijklmnopqrstuvwxyz"

# Twitch application credentials. OPTIONAL.
# Create an application at https://dev.twitch.tv/console/apps
# The "Client ID" is the application id; the "Client Secret" is the secret.
# Needed for Helix API calls (channel lookup, streams, followers).
# Without these, Twitch live checks and discovery are skipped.
TWITCH_CLIENT_ID="abc123def456ghi789jkl0"
TWITCH_CLIENT_SECRET="abcdef1234567890ghijklmnopqrstuvwxyz123456"

# VK service token. OPTIONAL.
# Create an app at https://vk.com/apps and request a service token.
# Enables profile refresh for VK channel IDs.
VK_ACCESS_TOKEN="vk1.a.exampletoken1234567890abcdef"

# CI.ME Open API credentials. OPTIONAL.
# Create an application at https://developers.ci.me
# Enables profile refresh for known CI.ME channel IDs (avatars, names,
# bios, follower counts) — the details pass needs both.
CI_ME_CLIENT_ID="ci-me-example-client-id"
CI_ME_CLIENT_SECRET="ci-me-example-secret-1234567890"

# Bilibili, Niconico, CHZZK and SOOP need no credentials — their public
# APIs are read directly by the pipeline adapters. Leave these blank.

# ─────────────────────────────────────────────────────────────
#  Web app configuration (baked into the public bundle — never
#  put a client secret in a VITE_* variable)
# ─────────────────────────────────────────────────────────────

# Google OAuth client id. Enables YouTube account linking.
# Create one at https://console.cloud.google.com/apis/credentials
# → OAuth client id → Web application.
VITE_GOOGLE_CLIENT_ID="123456789012-example.apps.googleusercontent.com"

# Twitch application client id. Enables Twitch account linking.
# A public client with PKCE — no secret is needed in the browser.
VITE_TWITCH_CLIENT_ID="abc123def456ghi789jkl0"

# VK application id. Enables VK account linking.
VITE_VK_CLIENT_ID="12345678"

# KICK application client id. Enables KICK account linking (OAuth 2.1 PKCE).
VITE_KICK_CLIENT_ID="example-kick-client-id"

# KICK application client secret. Needed for the token exchange with a
# registered KICK app; the cookie-based route needs neither.
VITE_KICK_CLIENT_SECRET="example-kick-client-secret"

# Base path of the deployment. "/" for a user/org page,
# "/<repo>/" for a GitHub Pages project page.
VITE_BASE_PATH="/"

# ─────────────────────────────────────────────────────────────
#  Legacy local dev server
# ─────────────────────────────────────────────────────────────

# The URL the app is hosted at (used for self-referential links).
APP_URL="http://localhost:5173"

# Gemini API key for the legacy AI Studio scaffold. Not used by the
# current app, but kept so the original template still builds.
GEMINI_API_KEY="AIzaExample1234567890abcdefghijklmnopqrstuvwxyz"
